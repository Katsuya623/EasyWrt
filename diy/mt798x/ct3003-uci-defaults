#!/bin/sh
# ============================================================
# CT3003 首次启动优化脚本（有线回程 AP 漫游版 — 最优实践）
# 由 op2.sh 复制到 /etc/uci-defaults/99-ct3003-optimize
# uci-defaults 机制：首次启动执行一次，执行后自动删除
# ============================================================

# --- DNS：运营商 DNS 为主 + 公共 DNS 备用 ---
uci set network.wan.peerdns='1'
uci del_list network.wan.dns='223.5.5.5' 2>/dev/null
uci del_list network.wan.dns='119.29.29.29' 2>/dev/null
uci add_list network.wan.dns='223.5.5.5'
uci add_list network.wan.dns='119.29.29.29'

# --- 禁用 LAN 侧 IPv6 ---
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ndp='disabled'

# ============================================================
# --- WiFi 频宽/信道/模式（wifi-device 段）---
# ============================================================
# 必须在 uci-defaults 里显式设 htmode/channel，
# 否则 op2.sh 改了 dat 文件频宽但 uci 没改，两层打架

# --- 2.4G wifi-device ---
uci set wireless.MT7981_1_1.htmode='HT20'    # 2.4G 20MHz，IoT 兼容性最佳
uci set wireless.MT7981_1_1.channel='1'       # 固定 ch1，配合多 AP 漫游错开信道

# --- 5G wifi-device ---
uci set wireless.MT7981_1_2.htmode='HE80'    # 5G 80MHz，千兆够用且漫游信道可错开
uci set wireless.MT7981_1_2.channel='36'      # ch36 非 DFS，无驱动报错

# ============================================================
# --- 802.11k 邻居报告（wifi-iface 段）---
# ============================================================
# ⚠️ 802.11r FT 在 MTK 闭源驱动上有致命缺陷，已禁用（见下方说明）
# 仅保留 802.11k RRM（邻居报告），帮助客户端发现周边 AP

# --- 2.4G ---
uci set wireless.default_MT7981_1_1.rrm='1'   # 802.11k 邻居报告

# --- 5G ---
uci set wireless.default_MT7981_1_2.rrm='1'   # 802.11k 邻居报告

# ============================================================
# --- 802.11r FT：禁用 ---
# ============================================================
# ⚠️ MTK mt_wifi 闭源驱动的 802.11r FT 实现有两个致命缺陷：
#    1. R0KH-ID 使用内部 MAC（如 Ralink:91:d1:66:57:a8:71），
#       与实际接口 MAC 不匹配 → AP 间无法定位 R0KH → "R0KH unreachable"
#    2. PMKID 推导不正确，即使设了 ft_psk_generate_local=0 + mobility_domain，
#       两端 PMKID 仍对不上 → "The PMKID is invalid"
#    实测结果：
#    - iPhone: PMKID invalid 后降级做完整 4-way → 漫游正常（靠 Apple 策略）
#    - Redmi: PMKID invalid 后反复重试 FT → 7+ 次全失败 → 断连
#    结论：开着 FT 反而让安卓设备在认证失败时反复重试导致断连，
#          关掉后所有设备走标准 4-way 认证，反而更稳定

# --- 禁用 UCI 层 FT 参数 ---
uci delete wireless.default_MT7981_1_1.ft_over_ds 2>/dev/null
uci delete wireless.default_MT7981_1_1.ft_psk_generate_local 2>/dev/null
uci delete wireless.default_MT7981_1_1.mobility_domain 2>/dev/null
uci delete wireless.default_MT7981_1_1.nas_identifier 2>/dev/null
uci delete wireless.default_MT7981_1_1.wnm_disassoc_imminent 2>/dev/null

uci delete wireless.default_MT7981_1_2.ft_over_ds 2>/dev/null
uci delete wireless.default_MT7981_1_2.ft_psk_generate_local 2>/dev/null
uci delete wireless.default_MT7981_1_2.mobility_domain 2>/dev/null
uci delete wireless.default_MT7981_1_2.nas_identifier 2>/dev/null
uci delete wireless.default_MT7981_1_2.wnm_disassoc_imminent 2>/dev/null

# ============================================================
# --- IGMP/MLD Snooping ---
# ============================================================
uci set network.lan.igmp_snooping='1'
uci set network.lan.multicast_querier='1'

# ============================================================
# --- MTK 原生 802.11r FT：禁用 ---
# ============================================================
# ⚠️ Dawn 在 MT7981 上不能用！MTK 闭源驱动 mt_wifi 不走 hostapd，
#    Dawn 报 "No hostapd sockets!" 无法工作。
# ⚠️ MTK 原生 FtSupport=1 也不能用！实测发现两个致命缺陷：
#    1. R0KH-ID 使用内部 MAC → "R0KH unreachable" → AP 间 FT 失败
#    2. PMKID 推导不正确 → "The PMKID is invalid" → 安卓反复重试断连
#    结论：MT7981 + mt_wifi 闭源驱动下，802.11r FT 完全不可用
#          只能依赖客户端自主漫游（Apple 最积极，安卓需手动切换）

# --- 关闭 MTK 原生 FtSupport（2.4G + 5G）---
for dat in /etc/wireless/mediatek/mt7981.dbdc.b0.dat \
           /etc/wireless/mediatek/mt7981.dbdc.b1.dat; do
    [ -f "$dat" ] && sed -i 's/^FtSupport=1$/FtSupport=0/' "$dat"
done

# DBDC_card0.dat 格式不同：FtSupport=1;1;
[ -f /etc/wireless/mediatek/DBDC_card0.dat ] && \
    sed -i 's/^FtSupport=1;1;$/FtSupport=0;0;/' /etc/wireless/mediatek/DBDC_card0.dat

# --- KickStaRssiLow 和 ForceRoamSupport：保持禁用 ---
# ⚠️ KickStaRssiLow=-75 会导致 ping-pong 死循环！
#    在两个 AP 交界区域，两边信号都约 -75~-78，两边都踢 → 设备反复跳 AP → 完全断网
#    ping-pong 比粘滞更糟糕：粘滞至少能上网（慢），ping-pong 完全不可用
# ⚠️ ForceRoamSupport iwpriv 不支持（"Command not Support"），设了也没用
for dat in /etc/wireless/mediatek/mt7981.dbdc.b0.dat \
           /etc/wireless/mediatek/mt7981.dbdc.b1.dat; do
    [ -f "$dat" ] && sed -i 's/^KickStaRssiLow=.*/KickStaRssiLow=0/' "$dat"
    [ -f "$dat" ] && sed -i 's/^ForceRoamSupport=.*/ForceRoamSupport=0/' "$dat"
done
[ -f /etc/wireless/mediatek/DBDC_card0.dat ] && \
    sed -i 's/^KickStaRssiLow=.*/KickStaRssiLow=0/' /etc/wireless/mediatek/DBDC_card0.dat
[ -f /etc/wireless/mediatek/DBDC_card0.dat ] && \
    sed -i 's/^ForceRoamSupport=.*/ForceRoamSupport=0/' /etc/wireless/mediatek/DBDC_card0.dat

# --- AssocReqRssiThres：保持禁用 ---
# ⚠️ AssocReqRssiThres=-70 在实测中同样有问题：
#    当设备在两 AP 交界区域时，两边信号都低于 -70 → 两边都拒绝关联 → 设备连不上任何 AP
#    虽然 KickStaRssiLow 是踢已连接设备(ping-pong)，AssocReqRssiThres 是拒新关联，
#    但效果一样：MTK 驱动信号太强，边界区域两边都不过阈值，设备被双向拒绝
# 结论：MT7981 + 闭源驱动的 AP 侧主动干预（kick/reject/roam/FT）全部不可用
#       只能依赖客户端自主漫游（Apple 最积极，安卓需手动切换）
for dat in /etc/wireless/mediatek/mt7981.dbdc.b0.dat \
           /etc/wireless/mediatek/mt7981.dbdc.b1.dat; do
    [ -f "$dat" ] && sed -i 's/^AssocReqRssiThres=.*/AssocReqRssiThres=0;0/' "$dat"
done

# --- 禁用 Dawn（与 MTK 驱动不兼容）---
/etc/init.d/dawn disable 2>/dev/null
/etc/init.d/dawn stop 2>/dev/null

# ============================================================
# --- 提交所有 uci 修改 ---
# ============================================================
uci commit network
uci commit dhcp
uci commit wireless

exit 0

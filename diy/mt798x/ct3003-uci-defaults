#!/bin/sh
# ============================================================
# CT3003 首次启动优化脚本（有线回程 AP 漫游版 — 最优实践）
# 由 op2.sh 复制到 /etc/uci-defaults/99-ct3003-optimize
# uci-defaults 机制：首次启动执行一次，执行后自动删除
# ============================================================

# --- DNS：运营商 DNS 为主 + 公共 DNS 备用 ---
uci set network.wan.peerdns='1'
uci del_list network.wan.dns='223.5.5.5' 2>/dev/null
uci del_list network.wan.dns='119.29.29.29' 2>/dev/null
uci add_list network.wan.dns='223.5.5.5'
uci add_list network.wan.dns='119.29.29.29'

# --- 禁用 LAN 侧 IPv6 ---
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ndp='disabled'

# ============================================================
# --- WiFi 频宽/信道/模式（wifi-device 段）---
# ============================================================
# 必须在 uci-defaults 里显式设 htmode/channel，
# 否则 op2.sh 改了 dat 文件频宽但 uci 没改，两层打架

# --- 2.4G wifi-device ---
uci set wireless.MT7981_1_1.htmode='HT20'    # 2.4G 20MHz，IoT 兼容性最佳
uci set wireless.MT7981_1_1.channel='1'       # 固定 ch1，配合多 AP 漫游错开信道

# --- 5G wifi-device ---
uci set wireless.MT7981_1_2.htmode='HE80'    # 5G 80MHz，千兆够用且漫游信道可错开
uci set wireless.MT7981_1_2.channel='36'      # ch36 非 DFS，无驱动报错

# ============================================================
# --- 802.11r/k/v 漫游参数（wifi-iface 段）---
# ============================================================
# ft/rrm/wnm 必须设在 wifi-iface 上，设在 wifi-device 上无效
# immortalwrt-mt798x iface section: default_MT7981_1_1 / default_MT7981_1_2

# --- 2.4G ---
uci set wireless.default_MT7981_1_1.ft_over_ds='1'
uci set wireless.default_MT7981_1_1.ft_psk_generate_local='1'
uci set wireless.default_MT7981_1_1.rrm='1'
uci set wireless.default_MT7981_1_1.wnm_disassoc_imminent='1'

# --- 5G ---
uci set wireless.default_MT7981_1_2.ft_over_ds='1'
uci set wireless.default_MT7981_1_2.ft_psk_generate_local='1'
uci set wireless.default_MT7981_1_2.rrm='1'
uci set wireless.default_MT7981_1_2.wnm_disassoc_imminent='1'

# ============================================================
# --- IGMP/MLD Snooping ---
# ============================================================
uci set network.lan.igmp_snooping='1'
uci set network.lan.multicast_querier='1'

# ============================================================
# --- Dawn 漫游控制器 ---
# ============================================================
# ⚠️ 不能用 dawn.@dawn[0] 语法！uci-defaults 执行时 Dawn 包
#    可能还没安装，@dawn[0] 找不到 section 会静默失败。
#    必须用具名 section：dawn.global / dawn.802_11a / dawn.802_11g
#    这些是 Dawn 默认配置文件里已有的 section 名

# --- global 漫游策略 ---
uci set dawn.global.kicking='3'                  # 踢除模式：3=基于 RSSI
uci set dawn.global.kicking_threshold='20'       # 踢除阈值差：20dBm
uci set dawn.global.min_number_to_kick='3'       # 至少 3 次评估才踢
uci set dawn.global.use_station_count='0'        # 不按连接数决策
uci set dawn.global.eval_probe_req='0'           # 不评估 probe 请求
uci set dawn.global.eval_auth_req='0'
uci set dawn.global.eval_assoc_req='0'
uci set dawn.global.set_hostapd_nr='1'           # 关键！让 Dawn 写邻居报告到 hostapd
uci set dawn.global.deny_assoc_reason='17'       # 802.11v 拒绝原因码 17

# --- 802_11a（5G 频段）---
uci set dawn.802_11a.rssi_val='-70'              # 漫游触发：-70dBm
uci set dawn.802_11a.low_rssi_val='-80'          # 踢除/拒绝：-80dBm
uci set dawn.802_11a.rssi_center='-70'           # RSSI 中心值

# --- 802_11g（2.4G 频段）---
uci set dawn.802_11g.rssi_val='-70'
uci set dawn.802_11g.low_rssi_val='-80'
uci set dawn.802_11g.rssi_center='-70'

# ============================================================
# --- 提交所有 uci 修改 ---
# ============================================================
uci commit network
uci commit dhcp
uci commit wireless
uci commit dawn

exit 0
